rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is an approved admin
    function isAdmin() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }

    // Users collection rules
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Admin accounts rules
    match /admins/{adminId} {
      allow create: if isAuthenticated() && request.auth.uid == adminId && (
        (request.resource.data.role == 'admin' && request.resource.data.status == 'approved' && !exists(/databases/$(database)/documents/metadata/config))
        ||
        (request.resource.data.role == 'pending' && request.resource.data.status == 'pending')
      );
      
      allow read: if isAuthenticated() && (
        request.auth.uid == adminId || 
        isAdmin()
      );
      
      allow update: if isAuthenticated() && (
        (request.auth.uid == adminId && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) &&
          (request.resource.data.status == resource.data.status || request.resource.data.status == 'pending')
        ))
        ||
        isAdmin()
      );
      
      allow delete: if isAdmin();
    }

    // Config metadata to track if first admin is created
    match /metadata/config {
      allow read: if true;
      allow create: if isAuthenticated() && !exists(/databases/$(database)/documents/metadata/config);
      allow update, delete: if isAdmin();
    }

    // Crushes collection rules
    match /crushes/{crushId} {
      allow read: if isAdmin() || (isAuthenticated() && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid ||
        resource.data.normalizedPhone == request.auth.token.phone_number
      ));
      allow create: if isAuthenticated() && (
        request.resource.data.fromUserId == request.auth.uid
      );
      allow update: if isAdmin() || (isAuthenticated() && (
        // Sender can update their own crush document
        (resource.data.fromUserId == request.auth.uid && request.resource.data.fromUserId == request.auth.uid) ||
        // Recipient can update status/revealed to complete a match
        ((resource.data.toUserId == request.auth.uid || resource.data.normalizedPhone == request.auth.token.phone_number) &&
          request.resource.data.status == 'matched' &&
          request.resource.data.revealed == true &&
          request.resource.data.toUserId == request.auth.uid)
      ));
      allow delete: if isAdmin() || (isAuthenticated() && (
        resource.data.fromUserId == request.auth.uid &&
        resource.data.status != 'matched'
      ));
    }

    // Matches collection rules
    match /matches/{matchId} {
      allow read: if isAdmin() || (isAuthenticated() && (
        request.auth.uid in resource.data.users
      ));
      // Matches can only be created/updated if the requester is one of the matched users      
      allow create, update: if isAdmin() || (isAuthenticated() && (
        request.auth.uid in request.resource.data.users
      ));
      allow delete: if isAdmin(); // Admins can delete matches, otherwise permanent
    }

    // Referrals collection rules
    match /referrals/{referralId} {
      allow read: if isAdmin() || (isAuthenticated() && (
        resource.data.referrerId == request.auth.uid ||
        resource.data.refereeId == request.auth.uid
      ));
      allow create: if isAuthenticated() && (
        request.resource.data.refereeId == request.auth.uid
      );
      allow update, delete: if isAdmin(); // Admins can delete referrals, otherwise immutable
    }

    // Waitlist collection rules
    match /waitlist/{document} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // App Config rules
    match /app_config/{document} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Notifications collection rules
    match /notifications/{notificationId} {
      allow read: if isAdmin() || (isAuthenticated() && (
        resource.data.type == 'general' ||
        resource.data.userId == request.auth.uid
      ));
      allow update: if isAuthenticated() && (
        (resource.data.userId == request.auth.uid && request.resource.data.isRead == true) ||
        isAdmin()
      );
      allow create, delete: if isAdmin();
    }
  }
}
